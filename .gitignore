# --- Out-of-Project Helper Scripts & Workflows ---
/scripts/*
!/scripts/update-package-manifests.py
/workflows/
/commit_push.ps1
/raise_prs.ps1
/scratch*.ps1
/scratch*.sh
/scratch*.py
/temp*.ps1
/temp*.sh
/temp*.py
