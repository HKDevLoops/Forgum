# =============================================================================
# Forgum .gitignore — Strict Project Files Only
# =============================================================================

# --- Rust Build Outputs & Artifacts ---
/target/
/target-linux/
**/*.rs.bk
Cargo.lock.bak
*.pdb

# --- Executables, Shared Libraries & Binaries ---
*.exe
*.dll
*.so
*.dylib
*.lib
*.a
*.out
*.app

# --- Temporary & Backup Files ---
*.tmp
*.err
*.bak
*.backup
*.orig
*~
*.swp
*.swo
*.scratch.*
scratch/
tmp/
temp/

# --- Operating System Artifacts ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- IDEs & Text Editors ---
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# --- Local Secrets & Credentials ---
.env
.env.*
*.pem
*.key
secrets/

# --- AI Agents, Instruction Files, Brain Harnesses & Scratch Markdowns ---
brain/
docs/superpowers/
.agents/
.claude/
.gemini/
.kilo/
kilo.json
AGENTS.md
GEMINI.md
