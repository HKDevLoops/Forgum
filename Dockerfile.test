FROM rust:latest

RUN apt-get update && apt-get install -y \
    pkg-config \
    libfontconfig1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN cargo build --workspace
RUN cargo test --workspace
RUN cargo clippy --workspace --all-targets -- -D warnings
RUN cargo fmt --check --all
